{
    "manifest_version": 3,
    "name": "STEPfwd Paste",
    "version": "1.0.0",
    "description": "Transfer plain text into STEPfwd virtual machines.",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "icons": {
        "128": "icon.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    }
}

